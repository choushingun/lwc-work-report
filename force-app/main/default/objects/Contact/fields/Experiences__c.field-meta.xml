<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Experiences__c</fullName>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(GraduateYearMonth__c), 0,
  FLOOR(
    ((YEAR(TODAY()) * 12 + MONTH(TODAY())) - (VALUE(LEFT(GraduateYearMonth__c, 4)) * 12 + VALUE(RIGHT(GraduateYearMonth__c, 2)))) / 12
  )
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>【履歴書】実務年数</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
